{
    "name": "gyulamad/task-board",
    "description": "PHP Task Board - lightweight multi-user task and message board",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-xml": "*",
        "ext-xmlwriter": "*"
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "test:sqlite": "phpunit --no-coverage",
        "test:mysql": [
            "@putenv TEST_DB_MODE=mysql",
            "phpunit --no-coverage"
        ],
        "test:coverage": "phpunit --coverage-clover build/coverage/clover.xml --coverage-html build/coverage/html --coverage-text"
    },
    "config": {
        "sort-packages": true
    }
}
